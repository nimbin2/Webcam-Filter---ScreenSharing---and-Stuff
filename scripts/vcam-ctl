#!/usr/bin/env bash
#
# vcam-ctl – complete runtime control for a running vcam process.
#
# Usage:
#   vcam-ctl <command> [args...]
#
# Overlay commands:
#   list                                                  show active overlays
#                                                         (draw order: first = bottom,
#                                                          last = on top)
#   add img      <id> <x> <y> [<w> [<h>]] <file>          image (PNG/JPEG)
#   add vid      <id> <x> <y> [<w> [<h>]] <file>          video (loops)
#   add vid-once <id> <x> <y> [<w> [<h>]] <file>          video (plays once)
#   add screen   <id> <x> <y> [<w> [<h>]] <WxH+X+Y>       live screen region
#   add webcam   <id> <x> <y> [<w> [<h>]] [-]            same webcam as the main
#                                                         pipeline, shown at <x,y>
#                                                         scaled to <w x h>. Path arg
#                                                         is unused — pass "-" or
#                                                         anything. Multiple webcam
#                                                         overlays are fine; they
#                                                         all share one capture.
#   remove <id>                                           remove one overlay
#   remove all                                            remove every overlay
#   move   <id> [x=N|N] [y=N|N]    Positional or x=/y=. Each value may
#                                  be a number, "keep", or "-" (= keep).
#                                  Missing = keep current. Default action
#                                  for positions is "keep".
#   resize <id> [w=N|N] [h=N|N]    Positional or w=/h=. Each value may
#                                  be a number, "keep", or "auto" / "-"
#                                  (derive from source aspect ratio).
#                                  Missing = auto. Default action for
#                                  resize is "auto".
#   raise  <id>                    bring overlay to the top (drawn last)
#   lower  <id>                    send overlay to the bottom (drawn first)
#   z      <id> <N>                explicit z-index: 0 = bottom, -1 = top,
#                                  -2 = second-from-top, etc.
#
# Filter commands:
#   filter help                                           list available filters
#   filter list                                           show active chain
#   filter add <name> [<param>]
#   filter set <index> <param>                            update parameter live
#   filter remove <index>
#   filter clear
#
# Screen commands (formerly the vcam-screen script):
#   screen                       Pick a region with slurp/slop and add it.
#                                Auto-picks a free ID (screen, screen2, …).
#   screen --full                Capture the whole monitor. If multiple
#                                monitors are connected and you didn't pass
#                                --monitor, an interactive picker appears.
#   screen --monitor <name|N>    Pick a specific monitor for --full, by
#                                connector name (e.g. DP-1, HDMI-A-1) or
#                                1-based index. Suppresses the picker.
#   screen --monitors            List connected monitors and exit.
#   screen --list                List active screen overlays.
#   screen --remove [id]         Remove a screen overlay (default id: "screen").
#   screen --remove-all          Remove all active screen overlays.
#
#   Screen options accepted with or without --full:
#     -i <id>      Overlay ID                  (default: auto)
#     -x <px>      Destination X               (default: 0)
#     -y <px>      Destination Y               (default: 0)
#     -w <px>      Destination width           (only -w preserves aspect)
#     -h <px>      Destination height
#     -r           Replace existing overlay with the same ID first
#
# Webcam-as-overlay quick command (great for screencasting):
#   webcam <tl|tr|bl|br|center|full> [width] [id]
#                                Add a webcam overlay that shares the
#                                main pipeline's V4L2 capture. Multiple
#                                instances are fine — pass a different
#                                <id> to avoid replacing. Default id is
#                                "cam", default width 320, position tr.
#                                "full" stretches it to the full output.
#   webcam off                   Remove the "cam" overlay.
#
# Recording (capture the vcam output to a file):
#   record start [-o <file>] [-m <alsa-dev>] [--no-audio] [--crf N]
#   record stop                  Flush + close file cleanly.
#   record pause / record resume Pause/resume in place (SIGSTOP/SIGCONT).
#   record status                "recording" / "paused" / "stopped".
#   record info                  Detailed status + elapsed duration.
#   record mics                  List ALSA capture devices.
#   record bar                   Print swaybar JSON for status_command.
#   record help                  Full record usage.
#
# Other:
#   help                                                  IPC command list
#   --help, -h                                            this message
#
# Notes:
#   - Passing only <w> (no <h>) preserves source aspect ratio for overlays.
#   - Default socket path is /tmp/vcam.sock. Override with VCAM_SOCK.
#   - See also: vcam-tune (interactive filter dial), vcam-setup (boot config).

SOCK="${VCAM_SOCK:-/tmp/vcam.sock}"

show_help() { sed -n '/^# vcam-ctl/,/^$/p' "$0" | sed 's/^# \?//'; }

# ── basic usage / help ───────────────────────────────────────
if [[ $# -eq 0 || "$1" == "-h" || "$1" == "--help" ]]; then
    show_help
    exit 0
fi

# ── check vcam is alive ──────────────────────────────────────
require_running() {
    if [[ ! -S "$SOCK" ]]; then
        echo "Error: vcam is not running (socket $SOCK not found)" >&2
        exit 1
    fi
}

# ── send an IPC command and print the reply ──────────────────
ipc_send() {
    require_running
    printf '%s\nquit\n' "$*" | ncat -U "$SOCK"
}

# ── bare-metal monitor detection ─────────────────────────────
# Lists connected monitors as one line each: "NAME WxH X Y"
# Uses /sys/class/drm for resolution (works everywhere). For accurate
# X/Y positions on multi-monitor setups, falls back to swaymsg if
# present — without it we report 0,0 for all monitors (correct for
# single-monitor; possibly wrong offset for non-primary on multi).
detect_monitors() {
    # Try sway first — it gives us real positions, not just resolutions.
    if command -v swaymsg >/dev/null 2>&1 \
       && swaymsg -t get_outputs --pretty 2>/dev/null | grep -q "^Output "; then
        swaymsg -t get_outputs --pretty 2>/dev/null | awk '
            /^Output / { name=$2 }
            /Current mode: / { mode=$3 }
            /Position: / {
                gsub(",", " ", $2)
                if (name && mode) {
                    split($2, p, " ")
                    print name, mode, p[1], p[2]
                    name=""; mode=""
                }
            }
        '
        return 0
    fi
    # Bare-metal fallback: /sys/class/drm — only gives resolution.
    for status_file in /sys/class/drm/card*/status; do
        [[ -r "$status_file" ]] || continue
        [[ "$status_file" =~ /card[0-9]+-[^/]+/status$ ]] || continue
        if [[ "$(cat "$status_file")" == "connected" ]]; then
            local dir="${status_file%/status}"
            local name mode
            name=$(basename "$dir" | sed 's/^card[0-9]*-//')
            mode=$(head -1 "$dir/modes" 2>/dev/null)
            if [[ -n "$mode" && "$mode" =~ ^[0-9]+x[0-9]+$ ]]; then
                echo "$name $mode 0 0"
            fi
        fi
    done
}

# Resolves a monitor selector (name or 1-based index) to a "NAME WxH X Y"
# line. Empty selector + single monitor → that monitor. Empty selector +
# multiple monitors → interactive prompt.
resolve_monitor() {
    local selector="$1"
    local lines
    lines=$(detect_monitors)
    [[ -z "$lines" ]] && { return 1; }

    local count
    count=$(echo "$lines" | wc -l)

    # Specific selector
    if [[ -n "$selector" ]]; then
        if [[ "$selector" =~ ^[0-9]+$ ]]; then
            echo "$lines" | sed -n "${selector}p"
        else
            echo "$lines" | awk -v n="$selector" '$1 == n { print; exit }'
        fi
        return 0
    fi

    # Single monitor: just use it
    if [[ $count -eq 1 ]]; then
        echo "$lines"
        return 0
    fi

    # Multiple monitors: interactive prompt
    # Only require stdin to be a TTY — stdout is captured by $(...) so
    # -t 1 would always fail when called via command substitution.
    if [[ ! -t 0 ]]; then
        echo "$lines" | head -1
        return 0
    fi

    echo "Multiple monitors connected:" >&2
    local i=0
    while IFS= read -r line; do
        i=$((i+1))
        read -r name mode x y <<< "$line"
        printf "  %d) %-12s %s  at (%d,%d)\n" "$i" "$name" "$mode" "$x" "$y" >&2
    done <<< "$lines"
    printf "Select monitor (1-%d, default 1): " "$count" >&2
    local choice
    read -r choice
    [[ -z "$choice" ]] && choice=1
    if ! [[ "$choice" =~ ^[0-9]+$ ]] || (( choice < 1 || choice > count )); then
        echo "Invalid selection" >&2; return 1
    fi
    echo "$lines" | sed -n "${choice}p"
}

# ──────────────────────────────────────────────────────────────
# screen subcommand — fully merged from old vcam-screen
# ──────────────────────────────────────────────────────────────
if [[ "$1" == "screen" ]]; then
    shift
    require_running

    ID=""
    DST_X=0; DST_Y=0; DST_W=0; DST_H=0
    REPLACE=0
    FULL=0
    MONITOR=""
    ACTION="add"   # add | list | remove | remove-all | monitors

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --help) show_help; exit 0 ;;
            -i) ID="$2"; shift 2 ;;
            -x) DST_X="$2"; shift 2 ;;
            -y) DST_Y="$2"; shift 2 ;;
            -w) DST_W="$2"; shift 2 ;;
            -h) DST_H="$2"; shift 2 ;;
            --full) FULL=1; shift ;;
            --monitor) MONITOR="$2"; shift 2 ;;
            --monitors) ACTION="monitors"; shift ;;
            -r|--replace) REPLACE=1; shift ;;
            --list) ACTION="list"; shift ;;
            --remove)
                ACTION="remove"
                if [[ $# -ge 2 && "$2" != -* ]]; then ID="$2"; shift 2
                else ID="screen"; shift; fi ;;
            --remove-all) ACTION="remove-all"; shift ;;
            *) echo "Unknown screen option: $1  (try --help)" >&2; exit 1 ;;
        esac
    done

    # ── list / remove / monitors paths ──
    if [[ "$ACTION" == "monitors" ]]; then
        lines=$(detect_monitors)
        if [[ -z "$lines" ]]; then
            echo "No monitors detected." >&2; exit 1
        fi
        i=0
        while IFS= read -r line; do
            i=$((i+1))
            read -r name mode x y <<< "$line"
            printf "  %d) %-12s %s  at (%d,%d)\n" "$i" "$name" "$mode" "$x" "$y"
        done <<< "$lines"
        exit 0
    fi

    if [[ "$ACTION" == "list" ]]; then
        ipc_send list | grep '\[screen\]' || echo "no screen overlays"
        exit 0
    fi
    if [[ "$ACTION" == "remove" ]]; then
        ipc_send "remove $ID"
        exit 0
    fi
    if [[ "$ACTION" == "remove-all" ]]; then
        ipc_send list | grep -oE '\[screen\] id=[^ ]+' | \
            awk -F= '{print $2}' | while read -r oid; do
                [[ -n "$oid" ]] && { echo "removing $oid"; ipc_send "remove $oid"; }
            done
        exit 0
    fi

    # ── add path ──
    # Auto-pick a free ID if user didn't provide one
    if [[ -z "$ID" ]]; then
        EXISTING=$(ipc_send list 2>/dev/null | grep -oE 'id=[^ ]+' | awk -F= '{print $2}')
        if ! echo "$EXISTING" | grep -qx "screen"; then
            ID="screen"
        else
            i=2
            while echo "$EXISTING" | grep -qx "screen$i"; do i=$((i+1)); done
            ID="screen$i"
        fi
    fi

    # Detect display server
    if [[ -n "${WAYLAND_DISPLAY:-}" ]]; then DS="wayland"
    elif [[ -n "${DISPLAY:-}" ]]; then       DS="x11"
    else
        echo "Error: neither WAYLAND_DISPLAY nor DISPLAY is set" >&2; exit 1
    fi

    # Obtain geometry
    GEOMETRY=""
    if [[ $FULL -eq 1 ]]; then
        SEL=$(resolve_monitor "$MONITOR")
        if [[ -z "$SEL" ]]; then
            echo "Could not resolve monitor selection." >&2
            echo "Run 'vcam-ctl screen --monitors' to list connected monitors." >&2
            exit 1
        fi
        read -r MNAME MMODE MX MY <<< "$SEL"
        GEOMETRY="${MMODE}+${MX}+${MY}"
        echo "Full screen on $MNAME: $GEOMETRY"
    else
        echo "Select a screen region..." >&2
        if [[ "$DS" == "wayland" ]]; then
            command -v slurp >/dev/null || { echo "slurp not installed" >&2; exit 1; }
            SLURP_RAW=$(slurp 2>/dev/null) || { echo "Cancelled." >&2; exit 1; }
            SX=$(echo "$SLURP_RAW" | cut -d',' -f1)
            SY=$(echo "$SLURP_RAW" | cut -d',' -f2 | cut -d' ' -f1)
            SW=$(echo "$SLURP_RAW" | cut -d' ' -f2 | cut -d'x' -f1)
            SH=$(echo "$SLURP_RAW" | cut -d' ' -f2 | cut -d'x' -f2)
            GEOMETRY="${SW}x${SH}+${SX}+${SY}"
        else
            if command -v slop >/dev/null; then
                GEOMETRY=$(slop -f "%wx%h+%x+%y" 2>/dev/null) || { echo "Cancelled." >&2; exit 1; }
            else
                echo "slop not installed. Enter geometry manually (WxH+X+Y):" >&2
                read -r GEOMETRY
            fi
        fi
        echo "Selected: $GEOMETRY" >&2
    fi

    if [[ $REPLACE -eq 1 ]]; then
        echo "Removing existing overlay '$ID'..." >&2
        ipc_send "remove $ID" >/dev/null || true
    fi

    ARGS="add screen $ID $DST_X $DST_Y"
    if   [[ $DST_W -gt 0 && $DST_H -gt 0 ]]; then ARGS="$ARGS $DST_W $DST_H"
    elif [[ $DST_W -gt 0 ]];                    then ARGS="$ARGS $DST_W"
    elif [[ $DST_H -gt 0 ]];                    then ARGS="$ARGS 0 $DST_H"
    fi
    ARGS="$ARGS $GEOMETRY"

    echo "Adding screen overlay '$ID'..." >&2
    ipc_send $ARGS
    echo "" >&2
    echo "Screen overlay '$ID' is live." >&2
    echo "  Remove:  vcam-ctl screen --remove $ID" >&2
    echo "  Move:    vcam-ctl move   $ID <x|-> [<y|->]" >&2
    echo "  Resize:  vcam-ctl resize $ID <w|-> [<h|->]" >&2
    exit 0
fi

# ──────────────────────────────────────────────────────────────
# webcam subcommand — add the webcam as a movable overlay
# ──────────────────────────────────────────────────────────────
# Useful in --no-input mode (or with a second camera) to show yourself
# in the corner while screensharing. Internally the webcam is an
# overlay just like images/videos, so move/resize/raise/lower work on
# it identically.
#
# Usage:
#   vcam-ctl webcam <position>     [width] [device]
#   vcam-ctl webcam off
#
#   position: tl|tr|bl|br|center   (top/bottom × left/right, or center)
#   width:    overlay width in px  (default 320; height auto from aspect)
#   device:   /dev/video<N>         (default /dev/video1)
#
# Examples:
#   vcam-ctl webcam tr             # 320-wide PiP in the top-right
#   vcam-ctl webcam br 480         # bigger, bottom-right
#   vcam-ctl webcam center         # centered on screen
#   vcam-ctl webcam off            # remove the webcam overlay
#
# Default ID is "cam". To run multiple webcam overlays, add them with
# the lower-level: vcam-ctl add webcam myid <x> <y> [<w>] <device>
if [[ "$1" == "webcam" ]]; then
    shift
    require_running
    POS="${1:-tr}"; WIDTH="${2:-320}"; ID="${3:-cam}"

    if [[ "$POS" == "off" || "$POS" == "remove" ]]; then
        ipc_send "remove $ID"
        exit 0
    fi

    # Output frame size — needed to compute corner positions.
    OUT="${VCAM_OUTPUT:-/dev/video0}"
    OUT_SIZE=""
    if command -v v4l2-ctl >/dev/null 2>&1; then
        OUT_SIZE=$(v4l2-ctl -d "$OUT" --get-fmt-video 2>/dev/null \
                   | awk -F'/' '/Width\/Height/{print $2}' | tr -d ' ')
    fi
    [[ "$OUT_SIZE" =~ ^[0-9]+x[0-9]+$ ]] || OUT_SIZE="1280x720"
    OUT_W="${OUT_SIZE%x*}"; OUT_H="${OUT_SIZE#*x}"

    # Webcam is 16:9 (height computed from width)
    HEIGHT=$(( WIDTH * 9 / 16 ))
    case "$POS" in
        tl)     X=0;                    Y=0 ;;
        tr)     X=$(( OUT_W - WIDTH )); Y=0 ;;
        bl)     X=0;                    Y=$(( OUT_H - HEIGHT )) ;;
        br)     X=$(( OUT_W - WIDTH )); Y=$(( OUT_H - HEIGHT )) ;;
        center) X=$(( (OUT_W - WIDTH) / 2 )); Y=$(( (OUT_H - HEIGHT) / 2 )) ;;
        full)   X=0; Y=0; WIDTH=$OUT_W; HEIGHT=$OUT_H ;;
        *) echo "Unknown position '$POS' (use tl|tr|bl|br|center|full|off)" >&2; exit 1 ;;
    esac

    # Replace any existing overlay with this ID
    ipc_send "remove $ID" >/dev/null 2>&1 || true
    echo "Adding webcam overlay '$ID' at $POS (${X},${Y}) width=$WIDTH"
    # The webcam overlay shares the main pipeline's capture; pass "-" as
    # the path argument since the type doesn't need one.
    ipc_send "add webcam $ID $X $Y $WIDTH -"

    echo ""
    echo "Webcam overlay '$ID' is live. Tweak with:"
    echo "  vcam-ctl move   $ID x=N y=N"
    echo "  vcam-ctl resize $ID w=N"
    echo "  vcam-ctl raise  $ID         # bring to top"
    echo "  vcam-ctl lower  $ID         # send to bottom"
    echo "  vcam-ctl z      $ID <N>     # explicit z-index"
    echo "  vcam-ctl webcam off          # remove (if id was 'cam')"
    exit 0
fi

# ──────────────────────────────────────────────────────────────
# record subcommand — drive an ffmpeg child to capture the vcam
# output (and optionally a microphone).
#
# State lives in three small files under /tmp so any tool (swaybar,
# polybar, conky, custom scripts) can read them without going through
# IPC:
#
#   /tmp/vcam-record.pid     ← PID of the running ffmpeg child
#   /tmp/vcam-record.status  ← "recording" or "paused"
#   /tmp/vcam-record.info    ← key=value lines: file, mic, started, format
#   /tmp/vcam-record.log     ← ffmpeg stderr (for debugging)
#
# Recording survives a vcam restart — it's an independent ffmpeg
# process. State files self-clean when stale.
# ──────────────────────────────────────────────────────────────
REC_PID="/tmp/vcam-record.pid"
REC_STATUS="/tmp/vcam-record.status"
REC_INFO="/tmp/vcam-record.info"
REC_LOG="/tmp/vcam-record.log"

rec_is_active() {
    [[ -f "$REC_PID" ]] || return 1
    local pid; pid=$(cat "$REC_PID" 2>/dev/null) || return 1
    [[ -z "$pid" ]] && return 1
    kill -0 "$pid" 2>/dev/null
}

rec_cleanup_stale() {
    if ! rec_is_active; then
        rm -f "$REC_PID" "$REC_STATUS" "$REC_INFO"
    fi
}

rec_list_mics() {
    if ! command -v arecord >/dev/null 2>&1; then
        echo "arecord not installed (sudo apt install alsa-utils)" >&2
        return 1
    fi
    echo "Hardware capture devices:"
    arecord -l 2>/dev/null | grep -E "^card|^  Subdev" \
        | awk -F: '/^card/{c=$1$2; printf "  %s\n", $0} /^  Subdev/{print "      " $0}'
    echo ""
    echo "ALSA PCM names (use with --mic):"
    # Filter to interesting ones — skip null/iec/loopback/dmix internals
    arecord -L 2>/dev/null | awk '
        /^[a-zA-Z]/ && !/^null$/ && !/^iec/ && !/^Loopback/ \
            && !/^dmix/ && !/^dsnoop/ && !/^plugequal/ \
            { name=$0; getline desc; printf "  %-25s %s\n", name, desc }'
}

rec_default_output() {
    local dir="${XDG_VIDEOS_DIR:-$HOME/Videos}"
    [[ -d "$dir" ]] || dir="$HOME"
    echo "$dir/vcam-$(date +%Y-%m-%d_%H-%M-%S).mkv"
}

if [[ "$1" == "record" ]]; then
    shift
    ACTION="${1:-help}"
    shift || true

    case "$ACTION" in
        # ── start ────────────────────────────────────────────
        start)
            rec_cleanup_stale
            if rec_is_active; then
                echo "Already recording (pid $(cat $REC_PID))." >&2
                echo "Use 'vcam-ctl record stop' first, or pass --replace." >&2
                # Allow --replace
                if [[ " $* " != *" --replace "* && " $* " != *" -r "* ]]; then
                    exit 1
                fi
                kill -TERM "$(cat $REC_PID)" 2>/dev/null
                sleep 0.5
                rm -f "$REC_PID" "$REC_STATUS" "$REC_INFO"
            fi

            OUT=""; MIC=""; NO_AUDIO=0; CRF=23
            VCODEC="libx264"; VPRESET="veryfast"
            VCAM_OUT="${VCAM_OUTPUT:-/dev/video0}"

            while [[ $# -gt 0 ]]; do
                case "$1" in
                    -o|--output)   OUT="$2"; shift 2 ;;
                    -m|--mic)      MIC="$2"; shift 2 ;;
                    --no-audio)    NO_AUDIO=1; shift ;;
                    --crf)         CRF="$2"; shift 2 ;;
                    --vcodec)      VCODEC="$2"; shift 2 ;;
                    --preset)      VPRESET="$2"; shift 2 ;;
                    -r|--replace)  shift ;;   # already handled
                    *) echo "Unknown record start option: $1" >&2; exit 1 ;;
                esac
            done

            OUT="${OUT:-$(rec_default_output)}"
            mkdir -p "$(dirname "$OUT")"

            if ! command -v ffmpeg >/dev/null 2>&1; then
                echo "ffmpeg not installed. (sudo apt install ffmpeg)" >&2
                exit 1
            fi

            # Auto-pick a microphone if user didn't ask for --no-audio and
            # didn't supply --mic. We try the ALSA "default" PCM first
            # (works on most systems including PipeWire's ALSA shim), then
            # fall back to the first hardware capture card we find via
            # arecord -l. Pass --no-audio to skip this entirely.
            if [[ $NO_AUDIO -eq 0 && -z "$MIC" ]]; then
                if arecord -L 2>/dev/null | grep -q '^default$'; then
                    MIC="default"
                elif command -v arecord >/dev/null 2>&1; then
                    # Parse "card N: ..., device M: ..." → "hw:N,M"
                    FIRST_HW=$(arecord -l 2>/dev/null \
                        | grep -E '^card [0-9]+' \
                        | head -1 \
                        | sed -E 's/^card ([0-9]+).* device ([0-9]+).*/hw:\1,\2/')
                    if [[ -n "$FIRST_HW" && "$FIRST_HW" =~ ^hw: ]]; then
                        MIC="$FIRST_HW"
                    fi
                fi
                if [[ -n "$MIC" ]]; then
                    echo "[record] auto-selected mic: $MIC" \
                         "(override with --mic, or skip with --no-audio)"
                else
                    echo "[record] no ALSA capture device found — recording video only"
                fi
            fi

            # Query the loopback's CURRENT format so ffmpeg doesn't try to
            # change it (which v4l2loopback rejects while vcam is writing
            # to it — that's what was making recording fail while ffplay/
            # browsers had the cam open). Passing matching parameters
            # turns ffmpeg's S_FMT call into a no-op.
            FMT_W=""; FMT_H=""; FMT_PIX=""; FMT_FPS=""
            if command -v v4l2-ctl >/dev/null 2>&1; then
                FMT_LINE=$(v4l2-ctl -d "$VCAM_OUT" --get-fmt-video 2>/dev/null \
                           | tr -d ' ')
                FMT_W=$(echo "$FMT_LINE" | awk -F'Width/Height:' '{print $2}' \
                        | awk -F'/' '{print $1}')
                FMT_H=$(echo "$FMT_LINE" | awk -F'Width/Height:' '{print $2}' \
                        | awk -F'/' '{print $2}' | awk -F',' '{print $1}')
                # PixelFormat is like "PixelFormat:'YUYV'(YUYV4:2:2)"
                FMT_RAW=$(v4l2-ctl -d "$VCAM_OUT" --get-fmt-video 2>/dev/null \
                          | awk -F"'" '/Pixel Format/{print $2}')
                # ffmpeg names: YUYV -> yuyv422, NV12 -> nv12, etc.
                case "$FMT_RAW" in
                    YUYV) FMT_PIX="yuyv422" ;;
                    UYVY) FMT_PIX="uyvy422" ;;
                    NV12) FMT_PIX="nv12" ;;
                    RGB3) FMT_PIX="rgb24" ;;
                    BGR3) FMT_PIX="bgr24" ;;
                    *)    FMT_PIX="" ;; # let ffmpeg figure it out
                esac
                # Frame rate
                FMT_FPS=$(v4l2-ctl -d "$VCAM_OUT" --get-parm 2>/dev/null \
                          | awk '/Frames per second/{print $4; exit}')
            fi

            # Build ffmpeg command — read the vcam loopback output.
            # v4l2loopback supports multiple readers, so this doesn't
            # interfere with browsers/OBS/ffplay also reading the cam,
            # as long as we don't ask for a format change.
            CMD=(ffmpeg -y -hide_banner -loglevel warning)

            # Pre-input options must come BEFORE -i
            [[ -n "$FMT_PIX" ]] && CMD+=(-input_format "$FMT_PIX")
            [[ -n "$FMT_W" && -n "$FMT_H" ]] && CMD+=(-video_size "${FMT_W}x${FMT_H}")
            [[ -n "$FMT_FPS" ]] && CMD+=(-framerate "$FMT_FPS")

            CMD+=(-f v4l2 -i "$VCAM_OUT")

            if [[ $NO_AUDIO -eq 0 && -n "$MIC" ]]; then
                # Try ALSA first. Many "PipeWire" systems still expose
                # ALSA via the pipewire-alsa plugin, so "default" usually
                # works without going to pulse/pipewire-pulse.
                CMD+=(-f alsa -ac 2 -i "$MIC")
            fi

            CMD+=(-c:v "$VCODEC" -preset "$VPRESET" -crf "$CRF" -pix_fmt yuv420p)
            if [[ $NO_AUDIO -eq 0 && -n "$MIC" ]]; then
                CMD+=(-c:a aac -b:a 160k)
            fi
            CMD+=("$OUT")

            # Spawn detached so it survives this shell exiting
            nohup "${CMD[@]}" </dev/null >"$REC_LOG" 2>&1 &
            PID=$!
            disown 2>/dev/null || true

            # Give it a moment to fail fast (bad device etc.)
            sleep 0.3
            if ! kill -0 "$PID" 2>/dev/null; then
                echo "ffmpeg exited immediately — see $REC_LOG:" >&2
                tail -n 5 "$REC_LOG" >&2
                exit 1
            fi

            echo "$PID" > "$REC_PID"
            echo "recording" > "$REC_STATUS"
            {
                echo "file=$OUT"
                echo "mic=${MIC:-none}"
                echo "started=$(date +%s)"
                echo "started_human=$(date '+%Y-%m-%d %H:%M:%S')"
                echo "format=${OUT##*.}"
                echo "vcodec=$VCODEC"
                echo "crf=$CRF"
            } > "$REC_INFO"

            echo "● Recording started"
            echo "   file: $OUT"
            echo "   pid:  $PID"
            [[ -n "$MIC" ]] && echo "   mic:  $MIC"
            ;;

        # ── stop ─────────────────────────────────────────────
        stop)
            if ! rec_is_active; then
                echo "Not currently recording." >&2
                rec_cleanup_stale
                exit 1
            fi
            PID=$(cat "$REC_PID")
            # Send 'q' on stdin? We redirected to /dev/null so use SIGINT,
            # which makes ffmpeg flush + write the trailer cleanly.
            kill -INT "$PID" 2>/dev/null || true
            for _ in $(seq 1 50); do
                kill -0 "$PID" 2>/dev/null || break
                sleep 0.1
            done
            if kill -0 "$PID" 2>/dev/null; then
                kill -TERM "$PID" 2>/dev/null
                sleep 0.5
                kill -KILL "$PID" 2>/dev/null
            fi
            OUT=$(grep '^file=' "$REC_INFO" 2>/dev/null | cut -d= -f2-)
            rm -f "$REC_PID" "$REC_STATUS" "$REC_INFO"
            echo "■ Recording stopped"
            [[ -n "$OUT" ]] && echo "   saved: $OUT"
            ;;

        # ── pause ────────────────────────────────────────────
        # SIGSTOP halts ffmpeg in place. Audio device may buffer a bit
        # of data while stopped; expect a tiny glitch on resume.
        pause)
            if ! rec_is_active; then echo "Not recording." >&2; exit 1; fi
            PID=$(cat "$REC_PID")
            kill -STOP "$PID"
            echo "paused" > "$REC_STATUS"
            echo "⏸ Recording paused (pid $PID)"
            ;;

        # ── resume ───────────────────────────────────────────
        resume|continue)
            if [[ ! -f "$REC_PID" ]]; then echo "No paused recording." >&2; exit 1; fi
            PID=$(cat "$REC_PID")
            kill -CONT "$PID"
            echo "recording" > "$REC_STATUS"
            echo "● Recording resumed (pid $PID)"
            ;;

        # ── status ───────────────────────────────────────────
        # Outputs one of: "recording", "paused", "stopped".
        # Designed for swaybar / polybar polling — exit code mirrors
        # the state so 'vcam-ctl record status >/dev/null' is enough.
        status)
            if rec_is_active; then
                cat "$REC_STATUS" 2>/dev/null || echo "recording"
                exit 0
            else
                rec_cleanup_stale
                echo "stopped"
                exit 1
            fi
            ;;

        # ── info ─────────────────────────────────────────────
        info)
            if ! rec_is_active; then
                rec_cleanup_stale
                echo "Not currently recording."
                exit 1
            fi
            echo "state=$(cat $REC_STATUS 2>/dev/null || echo recording)"
            echo "pid=$(cat $REC_PID)"
            [[ -f "$REC_INFO" ]] && cat "$REC_INFO"
            # Duration on the fly
            if [[ -f "$REC_INFO" ]]; then
                START=$(grep '^started=' "$REC_INFO" | cut -d= -f2)
                if [[ -n "$START" ]]; then
                    NOW=$(date +%s)
                    DUR=$((NOW - START))
                    printf "duration=%02d:%02d:%02d\n" \
                        $((DUR/3600)) $(((DUR%3600)/60)) $((DUR%60))
                fi
            fi
            ;;

        # ── mics: list available ALSA capture devices ─────────
        mics|devices)
            rec_list_mics
            ;;

        # ── bar: emit swaybar-compatible JSON (for status_command) ─
        bar)
            if rec_is_active; then
                STATE=$(cat "$REC_STATUS" 2>/dev/null || echo recording)
                START=$(grep '^started=' "$REC_INFO" 2>/dev/null | cut -d= -f2)
                NOW=$(date +%s)
                DUR=$((NOW - ${START:-NOW}))
                LBL=$(printf "%02d:%02d:%02d" $((DUR/3600)) $(((DUR%3600)/60)) $((DUR%60)))
                if [[ "$STATE" == "paused" ]]; then
                    printf '{"text":"⏸ REC %s","class":"paused","color":"#ffaa00"}\n' "$LBL"
                else
                    printf '{"text":"● REC %s","class":"recording","color":"#ff5555"}\n' "$LBL"
                fi
            else
                printf '{"text":"","class":"idle"}\n'
            fi
            ;;

        help|--help|-h|"")
            cat <<'HLP'
vcam-ctl record — capture the vcam loopback output to a file.

  record start [options]    Start recording.
    -o, --output <path>     Output file (default: $XDG_VIDEOS_DIR/vcam-<ts>.mkv)
    -m, --mic <device>      ALSA capture device (e.g. "default", "hw:1,0").
                            If omitted, vcam-ctl auto-picks: ALSA "default"
                            if present, otherwise the first hw:N,M from
                            'arecord -l'. Use 'vcam-ctl record mics' to see
                            available devices.
    --no-audio              Record video only (skip mic auto-detect).
    --crf <n>               x264 quality 0–51 (default 23, lower = better)
    --vcodec <name>         video codec (default libx264)
    --preset <name>         x264 preset (default veryfast)
    -r, --replace           kill any existing recording first

  record stop                Flush & close, write the file out cleanly.
  record pause               SIGSTOP the ffmpeg process (audio may glitch on resume).
  record resume              SIGCONT the ffmpeg process.
  record status              Print "recording" / "paused" / "stopped". Exit code
                             0 if active, 1 if not — handy for shell scripts.
  record info                Detailed info about the current recording.
  record mics                List available ALSA capture devices.
  record bar                 Emit one line of swaybar JSON for status_command.

State files (live under /tmp, readable by anything):
  /tmp/vcam-record.pid      PID of ffmpeg
  /tmp/vcam-record.status   "recording" or "paused"
  /tmp/vcam-record.info     file=, mic=, started=, format=
  /tmp/vcam-record.log      ffmpeg's own stderr

Swaybar (~/.config/sway/config):
  bar { status_command while date +'%T'; do vcam-ctl record bar; sleep 1; done }

Or simpler, use a custom status block that polls 'vcam-ctl record status'.
HLP
            ;;

        *) echo "Unknown record action: $ACTION (try 'vcam-ctl record help')" >&2; exit 1 ;;
    esac
    exit 0
fi

# ── default: pass everything else straight to the IPC server ─
ipc_send "$*"
