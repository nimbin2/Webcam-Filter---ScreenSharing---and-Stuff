#!/usr/bin/env bash
#
# vcam-tune – interactively adjust filter parameters with the keyboard.
#
# Three modes:
#
#   vcam-tune                  WALK MODE — navigate all active filters,
#                              adjust each, remove or reset as you go.
#
#   vcam-tune <name> [<step>]  Add the named filter (with its default
#                              parameter) and immediately dial it.
#
#   vcam-tune <index> [<step>] Dial an existing filter at the given
#                              index (see 'vcam-ctl filter list').
#
# Keys (single-filter and walk mode):
#   ↑ / k        increase current filter's parameter
#   ↓ / j        decrease current filter's parameter
#   r            reset current filter to its default value
#   x            remove current filter
#   a            add a new filter (opens picker menu)
#   q / Esc      quit (filter stays at its current value)
#
# Walk-mode-only keys:
#   → / l / Tab  next filter
#   ← / h        previous filter

set -eu

SOCK="${VCAM_SOCK:-/tmp/vcam.sock}"

# ── help ─────────────────────────────────────────────────────
if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    sed -n '/^# vcam-tune/,/^$/p' "$0" | sed 's/^# \?//'
    exit 0
fi

if [[ ! -S "$SOCK" ]]; then
    echo "Error: vcam is not running (socket $SOCK not found)" >&2
    exit 1
fi

# ── IPC helpers ──────────────────────────────────────────────
ipc() {
    printf '%s\nquit\n' "$*" | ncat -U "$SOCK" 2>/dev/null | head -1
}
ipc_lines() {
    printf '%s\nquit\n' "$*" | ncat -U "$SOCK" 2>/dev/null
}

# Read current filter list as parallel arrays: NAMES[], PARAMS[]
declare -a NAMES PARAMS DEFAULTS
read_filters() {
    NAMES=(); PARAMS=(); DEFAULTS=()
    local lines name param
    while IFS= read -r line; do
        if [[ "$line" =~ ^OK\ ([0-9]+):\ ([a-z]+)\ param=([0-9.\-]+) ]]; then
            local idx="${BASH_REMATCH[1]}"
            name="${BASH_REMATCH[2]}"
            param="${BASH_REMATCH[3]}"
            NAMES[idx]="$name"
            PARAMS[idx]="$param"
        fi
    done < <(ipc_lines "filter list")
}

# Sensible default step per filter type
default_step() {
    case "$1" in
        blur|pixelate|posterize|chromashift|wave|painterly|vangogh) echo 1 ;;
        kaleidoscope|picasso|voronoi|sine|modulo|scanlines) echo 1 ;;
        bitcrush) echo 1 ;;
        cartoon|solarize) echo 5 ;;
        brightness|contrast|swirl|rainbow|saturate) echo 0.1 ;;
        vignette|glitch|dream|bloom|glow|pinch|bulge|modern|cyberpunk|romantic|xor|polar) echo 0.05 ;;
        melt|popart|displace|ripple|crt|velvet|noir|julia|edges) echo 0.05 ;;
        *) echo 0.1 ;;
    esac
}

# Get the default parameter for a filter type by querying vcam.
# We add a temp filter just to learn its default, then remove it.
default_param_for() {
    case "$1" in
        pixelate) echo 8 ;;
        blur) echo 2 ;;
        vignette) echo 0.6 ;;
        brightness) echo 1.2 ;;
        contrast) echo 1.4 ;;
        posterize) echo 4 ;;
        chromashift) echo 5 ;;
        glitch) echo 0.3 ;;
        kaleidoscope) echo 6 ;;
        swirl) echo 1 ;;
        wave) echo 10 ;;
        cartoon) echo 50 ;;
        solarize) echo 128 ;;
        rainbow) echo 1 ;;
        dream|bloom|glow|pinch|bulge|modern|cyberpunk|romantic|polar) echo 0.5 ;;
        painterly|vangogh) echo 3 ;;
        picasso) echo 8 ;;
        sine) echo 15 ;;
        xor) echo 0.5 ;;
        modulo) echo 64 ;;
        voronoi) echo 20 ;;
        bitcrush) echo 3 ;;
        melt|displace|ripple|julia) echo 0.5 ;;
        popart) echo 1 ;;
        edges) echo 1.0 ;;
        saturate) echo 1.5 ;;
        crt) echo 0.7 ;;
        velvet) echo 0.6 ;;
        noir) echo 0.8 ;;
        scanlines) echo 3 ;;
        *) echo 1 ;;
    esac
}

# Portable float arithmetic
calc() { awk "BEGIN { printf \"%g\", $1 }"; }

# ── set a single parameter ───────────────────────────────────
set_param() {
    local index=$1 value=$2
    local resp
    resp=$(ipc "filter set $index $value")
    if [[ "$resp" =~ ^OK ]]; then
        PARAMS[index]="$value"
        return 0
    fi
    return 1
}

# All available filters, grouped by category.
# Updated when src/filter.c changes — keep in sync with the help table.
FILTER_CATEGORIES=(
    "Basic:grayscale sepia invert mirror flip pixelate blur vignette brightness contrast posterize edges saturate"
    "Fancy:chromashift glitch kaleidoscope swirl thermal oldfilm wave cartoon solarize rainbow crt"
    "Soft/Dreamy:dream bloom glow pinch bulge painterly velvet"
    "Themed:modern cyberpunk romantic vangogh picasso noir"
    "Math:sine xor modulo polar voronoi julia"
    "Pixel-crazy:bitcrush melt popart displace ripple scanlines"
)

# Show an interactive picker, return chosen filter name on stdout
# (returns nothing if cancelled). The caller is expected to have
# restored cooked-mode TTY before invoking; we handle our own.
pick_filter() {
    local saved=$(stty -g)
    stty echo icanon
    echo "" >&2
    echo "─── add a filter ─────────────────────────" >&2
    local idx=0
    local -a all_names
    for entry in "${FILTER_CATEGORIES[@]}"; do
        local cat="${entry%%:*}"
        local list="${entry#*:}"
        echo "" >&2
        echo "  ${cat}:" >&2
        local row=""
        for name in $list; do
            idx=$((idx + 1))
            all_names+=("$name")
            row+=$(printf "%3d) %-12s" "$idx" "$name")
            # Wrap every 3 entries
            if (( idx % 3 == 0 )); then
                echo "    $row" >&2
                row=""
            fi
        done
        [[ -n "$row" ]] && echo "    $row" >&2
    done
    echo "" >&2
    printf "Pick a filter (1-%d, or name, blank to cancel): " "$idx" >&2
    local choice
    read -r choice
    stty "$saved"
    [[ -z "$choice" ]] && return 1
    if [[ "$choice" =~ ^[0-9]+$ ]]; then
        local sel="${all_names[$((choice - 1))]:-}"
        [[ -z "$sel" ]] && return 1
        echo "$sel"
    else
        # Verify it's actually a known filter
        for name in "${all_names[@]}"; do
            if [[ "$name" == "$choice" ]]; then echo "$choice"; return 0; fi
        done
        return 1
    fi
    return 0
}

# ── single-filter mode ───────────────────────────────────────
if [[ $# -ge 1 ]]; then
    ARG="$1"
    STEP="${2:-}"

    if [[ "$ARG" =~ ^[0-9]+$ ]]; then
        # Dial existing filter at index
        read_filters
        INDEX="$ARG"
        if [[ -z "${NAMES[INDEX]:-}" ]]; then
            echo "No filter at index $INDEX" >&2; exit 1
        fi
        NAME="${NAMES[INDEX]}"
        DEFAULT=$(default_param_for "$NAME")
    else
        # Add the filter, then dial it
        NAME="$ARG"
        RESP=$(ipc "filter add $NAME")
        if [[ "$RESP" =~ ^ERR ]]; then
            echo "$RESP" >&2; exit 1
        fi
        read_filters
        INDEX=$((${#NAMES[@]} - 1))
        DEFAULT=$(default_param_for "$NAME")
    fi

    [[ -z "$STEP" ]] && STEP=$(default_step "$NAME")
    CURRENT="${PARAMS[INDEX]}"
    REMOVE_ON_EXIT=0

    stty_orig=$(stty -g)
    trap 'stty "$stty_orig"; echo' EXIT
    stty -echo -icanon time 0 min 1

    echo "vcam-tune  '$NAME' (index $INDEX)   step=$STEP"
    echo "  ↑/k=up  ↓/j=down  r=reset to $DEFAULT  q=quit  x=remove+quit"
    echo ""

    draw() { printf '\r\033[K  %s = %s  ' "$NAME" "$CURRENT"; }
    draw

    while :; do
        IFS= read -rsn1 c
        if [[ "$c" == $'\x1b' ]]; then
            IFS= read -rsn1 -t 0.05 c2 || c2=""
            [[ -z "$c2" ]] && break
            if [[ "$c2" == "[" ]]; then
                IFS= read -rsn1 c3
                case "$c3" in
                    A) set_param "$INDEX" "$(calc "$CURRENT + $STEP")" && CURRENT="${PARAMS[INDEX]}" ;;
                    B) set_param "$INDEX" "$(calc "$CURRENT - $STEP")" && CURRENT="${PARAMS[INDEX]}" ;;
                esac
            fi
        else
            case "$c" in
                k|K) set_param "$INDEX" "$(calc "$CURRENT + $STEP")" && CURRENT="${PARAMS[INDEX]}" ;;
                j|J) set_param "$INDEX" "$(calc "$CURRENT - $STEP")" && CURRENT="${PARAMS[INDEX]}" ;;
                r|R) set_param "$INDEX" "$DEFAULT" && CURRENT="${PARAMS[INDEX]}" ;;
                q|Q) break ;;
                x|X) REMOVE_ON_EXIT=1; break ;;
            esac
        fi
        draw
    done

    stty "$stty_orig"
    echo ""
    if [[ "$REMOVE_ON_EXIT" == "1" ]]; then
        ipc "filter remove $INDEX" >/dev/null
        echo "Removed."
    else
        echo "Final value: $NAME = $CURRENT  (active at index $INDEX)"
    fi
    exit 0
fi

# ── walk mode ────────────────────────────────────────────────
read_filters
if [[ ${#NAMES[@]} -eq 0 ]]; then
    echo "No filters active — opening picker to add one."
    SEL=$(pick_filter) || { echo "Cancelled."; exit 0; }
    DEF=$(default_param_for "$SEL")
    ipc "filter add $SEL $DEF" >/dev/null
    read_filters
    if [[ ${#NAMES[@]} -eq 0 ]]; then
        echo "Failed to add filter '$SEL'." >&2; exit 1
    fi
fi

CURRENT_IDX=0
NUM_FILTERS=${#NAMES[@]}

stty_orig=$(stty -g)
trap 'stty "$stty_orig"; echo' EXIT
stty -echo -icanon time 0 min 1

echo "vcam-tune walk mode  —  $NUM_FILTERS active filter(s)"
echo "  ↑/k=up  ↓/j=down  →/l/Tab=next  ←/h=prev  r=reset  x=remove  a=add  q=quit"
echo ""

draw() {
    local idx=$CURRENT_IDX
    printf '\r\033[K'
    if [[ $NUM_FILTERS -eq 0 ]]; then
        printf '[empty]  press \033[1;33ma\033[0m to add a filter, \033[1;33mq\033[0m to quit'
        return
    fi
    printf '[%d/%d]  ' $((idx + 1)) "$NUM_FILTERS"
    for i in "${!NAMES[@]}"; do
        if [[ $i -eq $idx ]]; then
            printf '\033[1;36m▶ %s=%s \033[0m' "${NAMES[i]}" "${PARAMS[i]}"
        else
            printf '  %s=%s ' "${NAMES[i]}" "${PARAMS[i]}"
        fi
    done
}
draw

while :; do
    IFS= read -rsn1 c
    if [[ "$c" == $'\x1b' ]]; then
        IFS= read -rsn1 -t 0.05 c2 || c2=""
        [[ -z "$c2" ]] && break  # plain Esc
        if [[ "$c2" == "[" ]]; then
            IFS= read -rsn1 c3
            # All directional keys need at least one filter
            if [[ $NUM_FILTERS -eq 0 ]]; then draw; continue; fi
            case "$c3" in
                A) # up
                    name="${NAMES[CURRENT_IDX]}"
                    step=$(default_step "$name")
                    set_param "$CURRENT_IDX" "$(calc "${PARAMS[CURRENT_IDX]} + $step")"
                    ;;
                B) # down
                    name="${NAMES[CURRENT_IDX]}"
                    step=$(default_step "$name")
                    set_param "$CURRENT_IDX" "$(calc "${PARAMS[CURRENT_IDX]} - $step")"
                    ;;
                C) # right
                    CURRENT_IDX=$(( (CURRENT_IDX + 1) % NUM_FILTERS )) ;;
                D) # left
                    CURRENT_IDX=$(( (CURRENT_IDX - 1 + NUM_FILTERS) % NUM_FILTERS )) ;;
            esac
        fi
    else
        case "$c" in
            a|A)
                # 'a' must work even when the chain is empty — handled later
                ;;
            q|Q)
                break ;;
            *)
                # Everything else needs a current filter
                if [[ $NUM_FILTERS -eq 0 ]]; then draw; continue; fi
                ;;
        esac
        case "$c" in
            k|K)
                name="${NAMES[CURRENT_IDX]}"
                step=$(default_step "$name")
                set_param "$CURRENT_IDX" "$(calc "${PARAMS[CURRENT_IDX]} + $step")"
                ;;
            j|J)
                name="${NAMES[CURRENT_IDX]}"
                step=$(default_step "$name")
                set_param "$CURRENT_IDX" "$(calc "${PARAMS[CURRENT_IDX]} - $step")"
                ;;
            l|L|$'\t')
                CURRENT_IDX=$(( (CURRENT_IDX + 1) % NUM_FILTERS )) ;;
            h|H)
                CURRENT_IDX=$(( (CURRENT_IDX - 1 + NUM_FILTERS) % NUM_FILTERS )) ;;
            r|R)
                name="${NAMES[CURRENT_IDX]}"
                def=$(default_param_for "$name")
                set_param "$CURRENT_IDX" "$def"
                ;;
            x|X)
                ipc "filter remove $CURRENT_IDX" >/dev/null
                read_filters
                NUM_FILTERS=${#NAMES[@]}
                if [[ $NUM_FILTERS -eq 0 ]]; then
                    echo ""
                    echo "All filters removed. Press 'a' to add one, or 'q' to quit."
                    NUM_FILTERS=0
                    CURRENT_IDX=0
                else
                    if [[ $CURRENT_IDX -ge $NUM_FILTERS ]]; then
                        CURRENT_IDX=$((NUM_FILTERS - 1))
                    fi
                fi
                ;;
            a|A)
                # Restore cooked TTY so the picker can read normally
                stty "$stty_orig"
                echo ""
                SEL=$(pick_filter) || SEL=""
                if [[ -n "$SEL" ]]; then
                    DEF=$(default_param_for "$SEL")
                    ipc "filter add $SEL $DEF" >/dev/null
                    read_filters
                    NUM_FILTERS=${#NAMES[@]}
                    CURRENT_IDX=$((NUM_FILTERS - 1))   # focus the new one
                fi
                # Back to raw mode for the walk
                stty -echo -icanon time 0 min 1
                echo ""
                ;;
        esac
    fi
    draw
done

stty "$stty_orig"
echo ""
echo "Done. Final filter chain:"
ipc_lines "filter list" | grep "^OK [0-9]" | sed 's/^OK /  /'
