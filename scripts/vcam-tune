#!/usr/bin/env bash
#
# vcam-tune – interactively adjust filter parameters with the keyboard.
#
# Three modes:
#
#   vcam-tune                  WALK MODE — navigate all active filters,
#                              adjust each, remove or reset as you go.
#
#   vcam-tune <name> [<step>]  Add the named filter (with its default
#                              parameter) and immediately dial it.
#
#   vcam-tune <index> [<step>] Dial an existing filter at the given
#                              index (see 'vcam-ctl filter list').
#
# Keys (single-filter and walk mode):
#   ↑ / k        increase current filter's parameter
#   ↓ / j        decrease current filter's parameter
#   r            reset current filter to its default value
#   x            remove current filter
#   a            add a new filter (opens picker menu)
#   q / Esc      quit (filter stays at its current value)
#
# Walk-mode-only keys:
#   → / l / Tab  next filter
#   ← / h        previous filter

set -eu

SOCK="${VCAM_SOCK:-/tmp/vcam.sock}"

# ── help ─────────────────────────────────────────────────────
if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    sed -n '/^# vcam-tune/,/^$/p' "$0" | sed 's/^# \?//'
    exit 0
fi

if [[ ! -S "$SOCK" ]]; then
    echo "Error: vcam is not running (socket $SOCK not found)" >&2
    exit 1
fi

# ── IPC helpers ──────────────────────────────────────────────
ipc() {
    printf '%s\nquit\n' "$*" | ncat -U "$SOCK" 2>/dev/null | head -1
}
ipc_lines() {
    printf '%s\nquit\n' "$*" | ncat -U "$SOCK" 2>/dev/null
}

# Read current filter list as parallel arrays: NAMES[], PARAMS[] (primary),
# and PARAMS2..4[] (extra tunable knobs — 0 unless the filter uses them).
declare -a NAMES PARAMS PARAMS2 PARAMS3 PARAMS4 DEFAULTS
read_filters() {
    NAMES=(); PARAMS=(); PARAMS2=(); PARAMS3=(); PARAMS4=(); DEFAULTS=()
    local line
    while IFS= read -r line; do
        if [[ "$line" =~ ^OK\ ([0-9]+):\ ([a-z-]+)\ param=([0-9.\-]+)\ p2=([0-9.\-]+)\ p3=([0-9.\-]+)\ p4=([0-9.\-]+) ]]; then
            local idx="${BASH_REMATCH[1]}"
            NAMES[idx]="${BASH_REMATCH[2]}"
            PARAMS[idx]="${BASH_REMATCH[3]}"
            PARAMS2[idx]="${BASH_REMATCH[4]}"
            PARAMS3[idx]="${BASH_REMATCH[5]}"
            PARAMS4[idx]="${BASH_REMATCH[6]}"
        elif [[ "$line" =~ ^OK\ ([0-9]+):\ ([a-z-]+)\ param=([0-9.\-]+) ]]; then
            # Older vcam without multi-param support
            local idx="${BASH_REMATCH[1]}"
            NAMES[idx]="${BASH_REMATCH[2]}"
            PARAMS[idx]="${BASH_REMATCH[3]}"
            PARAMS2[idx]=0; PARAMS3[idx]=0; PARAMS4[idx]=0
        fi
    done < <(ipc_lines "filter list")
}

# Which extra params does a filter actually use? Returns the highest
# param slot (1–4) that's meaningful for this filter, so the tuner
# doesn't offer dead knobs on single-param filters.
n_params_for() {
    case "$1" in
        neon|kaleidoscope|wave) echo 4 ;;
        chromashift|glitch|vignette|feedback|ripples|life|plasma) echo 3 ;;
        swirl|pinch|bulge|shuffle|rain|lightpaint|hologram|duotone|spotlight) echo 3 ;;
        contour|fireworks|infinity|moire) echo 2 ;;
        cartoon|drift|slitscan|mosh|zoompulse|oilslick|ascii|sketch) echo 2 ;;
        *) echo 1 ;;
    esac
}

# Human labels for each param slot per filter (slot 1 is generic).
param_label() {
    local name=$1 slot=$2
    case "$name:$slot" in
        chromashift:1) echo "r-shift" ;;
        chromashift:2) echo "b-shift" ;;
        chromashift:3) echo "r-vshift" ;;
        kaleidoscope:1) echo "segments" ;;
        kaleidoscope:2) echo "rot-deg" ;;
        kaleidoscope:3) echo "spin" ;;
        glitch:1) echo "intensity" ;;
        glitch:2) echo "slice-h" ;;
        glitch:3) echo "shift-pct" ;;
        vignette:1) echo "strength" ;;
        vignette:2) echo "radius" ;;
        vignette:3) echo "warmth" ;;
        wave:1) echo "amp" ;;
        wave:2) echo "freq" ;;
        wave:3) echo "speed" ;;
        wave:4) echo "vert" ;;
        feedback:1) echo "decay" ;;
        feedback:2) echo "zoom" ;;
        feedback:3) echo "rot" ;;
        kaleidoscope:4) echo "zoom" ;;
        neon:1) echo "strength" ;;
        neon:2) echo "thresh" ;;
        neon:3) echo "huespd" ;;
        neon:4) echo "glow" ;;
        ripples:1) echo "sens" ;;
        ripples:2) echo "rain" ;;
        ripples:3) echo "refract" ;;
        life:1) echo "density" ;;
        life:2) echo "color" ;;
        life:3) echo "speed" ;;
        plasma:1) echo "blend" ;;
        plasma:2) echo "speed" ;;
        plasma:3) echo "scale" ;;
        contour:1) echo "levels" ;;
        contour:2) echo "dim" ;;
        fireworks:1) echo "sens" ;;
        fireworks:2) echo "burst" ;;
        infinity:1) echo "scale" ;;
        infinity:2) echo "rot" ;;
        moire:1) echo "spacing" ;;
        moire:2) echo "speed" ;;
        swirl:2) echo "radius" ;;
        swirl:3) echo "spin" ;;
        pinch:2|bulge:2) echo "cx" ;;
        pinch:3|bulge:3) echo "cy" ;;
        cartoon:2) echo "levels" ;;
        shuffle:2) echo "size" ;;
        shuffle:3) echo "phase-s" ;;
        rain:2) echo "speed" ;;
        rain:3) echo "trail" ;;
        drift:2) echo "max-shift" ;;
        slitscan:2) echo "dir" ;;
        mosh:2) echo "keyint" ;;
        lightpaint:2) echo "thresh" ;;
        lightpaint:3) echo "huespd" ;;
        hologram:2) echo "gap" ;;
        hologram:3) echo "glitch" ;;
        zoompulse:2) echo "rate" ;;
        oilslick:2) echo "speed" ;;
        ascii:1) echo "cell" ;;
        ascii:2) echo "mode" ;;
        duotone:1) echo "hueA" ;;
        duotone:2) echo "hueB" ;;
        duotone:3) echo "mix" ;;
        sketch:1) echo "detail" ;;
        sketch:2) echo "dark" ;;
        spotlight:1) echo "radius" ;;
        spotlight:2) echo "dark" ;;
        spotlight:3) echo "speed" ;;
        *:1) echo "param" ;;
        *) echo "p$slot" ;;
    esac
}

# Per-slot steps where the primary step isn't right
param_step() {
    local name=$1 slot=$2
    case "$name:$slot" in
        kaleidoscope:2) echo 5 ;;      # rotation degrees
        kaleidoscope:3) echo 0.25 ;;   # spin deg/frame
        glitch:2)       echo 2 ;;      # slice height px
        glitch:3)       echo 2 ;;      # shift percent
        vignette:2)     echo 0.05 ;;
        vignette:3)     echo 0.05 ;;
        wave:2)         echo 0.5 ;;    # waves/screen
        wave:3)         echo 0.02 ;;   # phase speed
        wave:4)         echo 1 ;;      # vert toggle
        feedback:2)     echo 0.01 ;;   # zoom per frame
        feedback:3)     echo 0.5 ;;    # degrees per frame
        kaleidoscope:4) echo 0.05 ;;   # wedge zoom
        neon:2)         echo 5 ;;      # edge threshold
        neon:3)         echo 0.2 ;;    # hue speed
        neon:4)         echo 0.05 ;;   # glow
        ripples:2)      echo 1 ;;      # rain drops/sec
        ripples:3)      echo 0.5 ;;    # refraction
        life:2)         echo 1 ;;      # color mode toggle
        life:3)         echo 1 ;;      # frames per generation
        plasma:2)       echo 0.1 ;;    # speed
        plasma:3)       echo 5 ;;      # scale px
        contour:2)      echo 0.05 ;;   # dim
        fireworks:2)    echo 0.25 ;;   # burst multiplier
        infinity:2)     echo 1 ;;      # rotation deg
        moire:2)        echo 0.1 ;;    # speed
        swirl:2)        echo 0.05 ;;
        swirl:3)        echo 0.2 ;;
        pinch:2|pinch:3|bulge:2|bulge:3) echo 0.05 ;;
        cartoon:2)      echo 1 ;;
        shuffle:2)      echo 8 ;;
        shuffle:3)      echo 0.25 ;;
        rain:2)         echo 0.2 ;;
        rain:3)         echo 4 ;;
        drift:2)        echo 5 ;;
        slitscan:2)     echo 1 ;;
        mosh:2)         echo 30 ;;
        lightpaint:2)   echo 5 ;;
        lightpaint:3)   echo 0.2 ;;
        hologram:2)     echo 1 ;;
        hologram:3)     echo 0.1 ;;
        zoompulse:2)    echo 0.1 ;;
        oilslick:2)     echo 0.2 ;;
        duotone:2)      echo 10 ;;
        duotone:3)      echo 0.05 ;;
        sketch:2)       echo 0.05 ;;
        spotlight:2)    echo 0.05 ;;
        spotlight:3)    echo 0.02 ;;
        chromashift:2)  echo 1 ;;
        chromashift:3)  echo 1 ;;
        *) default_step "$name" ;;
    esac
}

# Sensible default step per filter type
default_step() {
    case "$1" in
        blur|pixelate|posterize|chromashift|wave|painterly|vangogh) echo 1 ;;
        kaleidoscope|picasso|voronoi|sine|modulo|scanlines) echo 1 ;;
        bitcrush) echo 1 ;;
        drift) echo 1 ;;
        cartoon|solarize) echo 5 ;;
        brightness|contrast|swirl|rainbow|saturate) echo 0.1 ;;
        vignette|glitch|dream|bloom|glow|pinch|bulge|modern|cyberpunk|romantic|xor|polar) echo 0.05 ;;
        melt|popart|displace|ripple|crt|velvet|noir|julia|edges) echo 0.05 ;;
        shuffle|pixelsort|rgbdelay|rain) echo 0.05 ;;
        echo|slitscan|mosh|neon) echo 0.05 ;;
        stutter) echo 1 ;;
        halftone) echo 2 ;;
        dither|tiles) echo 1 ;;
        emboss|zoompulse|oilslick|ripples|hologram|life|feedback) echo 0.05 ;;
        lightpaint) echo 0.01 ;;
        mathwarp) echo 0.1 ;;
        plasma|fireworks|infinity) echo 0.05 ;;
        contour|moire) echo 1 ;;
        ascii) echo 8 ;;
        duotone) echo 10 ;;
        sketch) echo 1 ;;
        spotlight) echo 20 ;;
        *) echo 0.1 ;;
    esac
}

# Get the default parameter for a filter type by querying vcam.
# We add a temp filter just to learn its default, then remove it.
default_param_for() {
    case "$1" in
        pixelate) echo 8 ;;
        blur) echo 2 ;;
        vignette) echo 0.6 ;;
        brightness) echo 1.2 ;;
        contrast) echo 1.4 ;;
        posterize) echo 4 ;;
        chromashift) echo 5 ;;
        glitch) echo 0.3 ;;
        kaleidoscope) echo 6 ;;
        swirl) echo 1 ;;
        wave) echo 10 ;;
        cartoon) echo 50 ;;
        solarize) echo 128 ;;
        rainbow) echo 1 ;;
        dream|bloom|glow|pinch|bulge|modern|cyberpunk|romantic|polar) echo 0.5 ;;
        painterly|vangogh) echo 3 ;;
        picasso) echo 8 ;;
        sine) echo 15 ;;
        xor) echo 0.5 ;;
        modulo) echo 64 ;;
        voronoi) echo 20 ;;
        bitcrush) echo 3 ;;
        melt|displace|ripple|julia) echo 0.5 ;;
        popart) echo 1 ;;
        edges) echo 1.0 ;;
        saturate) echo 1.5 ;;
        crt) echo 0.7 ;;
        velvet) echo 0.6 ;;
        noir) echo 0.8 ;;
        scanlines) echo 3 ;;
        shuffle) echo 0.4 ;;
        pixelsort) echo 0.3 ;;
        rgbdelay) echo 0.7 ;;
        drift) echo 8 ;;
        rain) echo 0.4 ;;
        echo) echo 0.6 ;;
        slitscan) echo 0.7 ;;
        mosh) echo 0.5 ;;
        stutter) echo 6 ;;
        halftone) echo 8 ;;
        neon) echo 0.7 ;;
        emboss) echo 1 ;;
        dither) echo 2 ;;
        tiles) echo 3 ;;
        zoompulse) echo 0.5 ;;
        oilslick) echo 0.6 ;;
        feedback) echo 0.85 ;;
        ripples) echo 0.6 ;;
        lightpaint) echo 0.94 ;;
        hologram) echo 0.8 ;;
        life) echo 0.5 ;;
        mathwarp) echo 1 ;;
        plasma) echo 0.5 ;;
        contour) echo 8 ;;
        fireworks) echo 0.6 ;;
        infinity) echo 0.55 ;;
        moire) echo 12 ;;
        ascii) echo 8 ;;
        duotone) echo 220 ;;
        sketch) echo 2 ;;
        spotlight) echo 180 ;;
        *) echo 1 ;;
    esac
}

# Portable float arithmetic
calc() { awk "BEGIN { printf \"%g\", $1 }"; }

# ── set a single parameter ───────────────────────────────────
# set_param <index> <value> [<slot>]   slot: 1 (default) .. 4
set_param() {
    local index=$1 value=$2 slot="${3:-1}"
    local resp
    if [[ "$slot" == "1" ]]; then
        resp=$(ipc "filter set $index $value")
    else
        resp=$(ipc "filter set $index p$slot $value")
    fi
    if [[ "$resp" =~ ^OK ]]; then
        case "$slot" in
            1) PARAMS[index]="$value" ;;
            2) PARAMS2[index]="$value" ;;
            3) PARAMS3[index]="$value" ;;
            4) PARAMS4[index]="$value" ;;
        esac
        return 0
    fi
    return 1
}

# get the current value of a slot
get_param() {
    local index=$1 slot="${2:-1}"
    case "$slot" in
        1) echo "${PARAMS[index]}" ;;
        2) echo "${PARAMS2[index]:-0}" ;;
        3) echo "${PARAMS3[index]:-0}" ;;
        4) echo "${PARAMS4[index]:-0}" ;;
    esac
}

# All available filters, grouped by category.
# Updated when src/filter.c changes — keep in sync with the help table.
FILTER_CATEGORIES=(
    "Basic:grayscale sepia invert mirror flip pixelate blur vignette brightness contrast posterize edges saturate"
    "Fancy:chromashift glitch kaleidoscope swirl thermal oldfilm wave cartoon solarize rainbow crt"
    "Soft/Dreamy:dream bloom glow pinch bulge painterly velvet"
    "Themed:modern cyberpunk romantic vangogh picasso noir"
    "Math:sine xor modulo polar voronoi julia"
    "Pixel-crazy:bitcrush melt popart displace ripple scanlines"
    "Glitch-art:shuffle pixelsort rgbdelay drift rain"
    "Temporal:echo slitscan mosh stutter halftone neon"
    "Retro/Warp:emboss dither tiles zoompulse oilslick"
    "Interactive:ripples lightpaint fireworks spotlight feedback hologram life mathwarp"
    "Demoscene:plasma contour infinity moire"
    "Artistic:ascii duotone sketch"
)

# Show an interactive picker, return chosen filter name on stdout
# (returns nothing if cancelled). The caller is expected to have
# restored cooked-mode TTY before invoking; we handle our own.
pick_filter() {
    local saved=$(stty -g)
    stty echo icanon
    echo "" >&2
    echo "─── add a filter ─────────────────────────" >&2
    local idx=0
    local -a all_names
    for entry in "${FILTER_CATEGORIES[@]}"; do
        local cat="${entry%%:*}"
        local list="${entry#*:}"
        echo "" >&2
        echo "  ${cat}:" >&2
        local row=""
        for name in $list; do
            idx=$((idx + 1))
            all_names+=("$name")
            row+=$(printf "%3d) %-12s" "$idx" "$name")
            # Wrap every 3 entries
            if (( idx % 3 == 0 )); then
                echo "    $row" >&2
                row=""
            fi
        done
        [[ -n "$row" ]] && echo "    $row" >&2
    done
    echo "" >&2
    printf "Pick a filter (1-%d, or name, blank to cancel): " "$idx" >&2
    local choice
    read -r choice
    stty "$saved"
    [[ -z "$choice" ]] && return 1
    if [[ "$choice" =~ ^[0-9]+$ ]]; then
        local sel="${all_names[$((choice - 1))]:-}"
        [[ -z "$sel" ]] && return 1
        echo "$sel"
    else
        # Verify it's actually a known filter
        for name in "${all_names[@]}"; do
            if [[ "$name" == "$choice" ]]; then echo "$choice"; return 0; fi
        done
        return 1
    fi
    return 0
}

# ── single-filter mode ───────────────────────────────────────
if [[ $# -ge 1 ]]; then
    ARG="$1"
    STEP="${2:-}"

    if [[ "$ARG" =~ ^[0-9]+$ ]]; then
        # Dial existing filter at index
        read_filters
        INDEX="$ARG"
        if [[ -z "${NAMES[INDEX]:-}" ]]; then
            echo "No filter at index $INDEX" >&2; exit 1
        fi
        NAME="${NAMES[INDEX]}"
        DEFAULT=$(default_param_for "$NAME")
    else
        # Add the filter, then dial it
        NAME="$ARG"
        RESP=$(ipc "filter add $NAME")
        if [[ "$RESP" =~ ^ERR ]]; then
            echo "$RESP" >&2; exit 1
        fi
        read_filters
        INDEX=$((${#NAMES[@]} - 1))
        DEFAULT=$(default_param_for "$NAME")
    fi

    [[ -z "$STEP" ]] && STEP=$(default_step "$NAME")
    CURRENT="${PARAMS[INDEX]}"
    REMOVE_ON_EXIT=0

    stty_orig=$(stty -g)
    trap 'stty "$stty_orig"; echo' EXIT
    stty -echo -icanon time 0 min 1

    echo "vcam-tune  '$NAME' (index $INDEX)   step=$STEP"
    echo "  ↑/k=up  ↓/j=down  r=reset to $DEFAULT  q=quit  x=remove+quit"
    echo ""

    draw() { printf '\r\033[K  %s = %s  ' "$NAME" "$CURRENT"; }
    draw

    while :; do
        IFS= read -rsn1 c
        if [[ "$c" == $'\x1b' ]]; then
            IFS= read -rsn1 -t 0.05 c2 || c2=""
            [[ -z "$c2" ]] && break
            if [[ "$c2" == "[" ]]; then
                IFS= read -rsn1 c3
                case "$c3" in
                    A) set_param "$INDEX" "$(calc "$CURRENT + $STEP")" && CURRENT="${PARAMS[INDEX]}" ;;
                    B) set_param "$INDEX" "$(calc "$CURRENT - $STEP")" && CURRENT="${PARAMS[INDEX]}" ;;
                esac
            fi
        else
            case "$c" in
                k|K) set_param "$INDEX" "$(calc "$CURRENT + $STEP")" && CURRENT="${PARAMS[INDEX]}" ;;
                j|J) set_param "$INDEX" "$(calc "$CURRENT - $STEP")" && CURRENT="${PARAMS[INDEX]}" ;;
                r|R) set_param "$INDEX" "$DEFAULT" && CURRENT="${PARAMS[INDEX]}" ;;
                q|Q) break ;;
                x|X) REMOVE_ON_EXIT=1; break ;;
            esac
        fi
        draw
    done

    stty "$stty_orig"
    echo ""
    if [[ "$REMOVE_ON_EXIT" == "1" ]]; then
        ipc "filter remove $INDEX" >/dev/null
        echo "Removed."
    else
        echo "Final value: $NAME = $CURRENT  (active at index $INDEX)"
    fi
    exit 0
fi

# ── walk mode ────────────────────────────────────────────────
read_filters
if [[ ${#NAMES[@]} -eq 0 ]]; then
    echo "No filters active — opening picker to add one."
    SEL=$(pick_filter) || { echo "Cancelled."; exit 0; }
    DEF=$(default_param_for "$SEL")
    ipc "filter add $SEL $DEF" >/dev/null
    read_filters
    if [[ ${#NAMES[@]} -eq 0 ]]; then
        echo "Failed to add filter '$SEL'." >&2; exit 1
    fi
fi

CURRENT_IDX=0
NUM_FILTERS=${#NAMES[@]}

stty_orig=$(stty -g)
trap 'stty "$stty_orig"; echo' EXIT
stty -echo -icanon time 0 min 1

echo "vcam-tune walk mode  —  $NUM_FILTERS active filter(s)"
echo "  ↑↓/kj = adjust value      Tab/p/1-4 = switch PARAM of this filter"
echo "  ←→/hn = switch FILTER     r=reset  x=remove  a=add  q=quit"
echo ""

CUR_SLOT=1

# adjust the selected slot of the current filter by +/- its step
adjust() {
    local dir=$1
    local name="${NAMES[CURRENT_IDX]}"
    local step; step=$(param_step "$name" "$CUR_SLOT")
    local cur;  cur=$(get_param "$CURRENT_IDX" "$CUR_SLOT")
    set_param "$CURRENT_IDX" "$(calc "$cur $dir $step")" "$CUR_SLOT"
}

draw() {
    local idx=$CURRENT_IDX
    printf '\r\033[K'
    if [[ $NUM_FILTERS -eq 0 ]]; then
        printf '[empty]  press \033[1;33ma\033[0m to add a filter, \033[1;33mq\033[0m to quit'
        return
    fi
    printf '[%d/%d]  ' $((idx + 1)) "$NUM_FILTERS"
    for i in "${!NAMES[@]}"; do
        local name="${NAMES[i]}"
        local np; np=$(n_params_for "$name")
        if [[ $i -eq $idx ]]; then
            printf '\033[1;36m▶ %s\033[0m' "$name"
            # Show each tunable slot; highlight the selected one
            for ((s=1; s<=np; s++)); do
                local lbl; lbl=$(param_label "$name" "$s")
                local val; val=$(get_param "$i" "$s")
                if [[ $s -eq $CUR_SLOT ]]; then
                    printf ' \033[1;33m[%s=%s]\033[0m' "$lbl" "$val"
                else
                    printf ' %s=%s' "$lbl" "$val"
                fi
            done
            printf ' '
        else
            printf '  %s=%s ' "$name" "${PARAMS[i]}"
        fi
    done
}
draw

while :; do
    IFS= read -rsn1 c
    if [[ "$c" == $'\x1b' ]]; then
        IFS= read -rsn1 -t 0.05 c2 || c2=""
        [[ -z "$c2" ]] && break  # plain Esc
        if [[ "$c2" == "[" ]]; then
            IFS= read -rsn1 c3
            # All directional keys need at least one filter
            if [[ $NUM_FILTERS -eq 0 ]]; then draw; continue; fi
            case "$c3" in
                A) adjust "+" ;;
                B) adjust "-" ;;
                C) CURRENT_IDX=$(( (CURRENT_IDX + 1) % NUM_FILTERS )); CUR_SLOT=1 ;;
                D) CURRENT_IDX=$(( (CURRENT_IDX - 1 + NUM_FILTERS) % NUM_FILTERS )); CUR_SLOT=1 ;;
            esac
        fi
    else
        case "$c" in
            a|A)
                # 'a' must work even when the chain is empty — handled later
                ;;
            q|Q)
                break ;;
            *)
                # Everything else needs a current filter
                if [[ $NUM_FILTERS -eq 0 ]]; then draw; continue; fi
                ;;
        esac
        case "$c" in
            k|K) adjust "+" ;;
            j|J) adjust "-" ;;
            p|P|$'\t')
                # Tab / p: cycle through the current filter's tunable
                # param slots (only moves if the filter has extras)
                name="${NAMES[CURRENT_IDX]}"
                np=$(n_params_for "$name")
                CUR_SLOT=$(( CUR_SLOT % np + 1 ))
                ;;
            1|2|3|4)
                # jump straight to a slot if the filter has it
                name="${NAMES[CURRENT_IDX]}"
                np=$(n_params_for "$name")
                if [[ $c -le $np ]]; then CUR_SLOT=$c; fi
                ;;
            l|L|n|N)
                CURRENT_IDX=$(( (CURRENT_IDX + 1) % NUM_FILTERS )); CUR_SLOT=1 ;;
            h|H)
                CURRENT_IDX=$(( (CURRENT_IDX - 1 + NUM_FILTERS) % NUM_FILTERS )); CUR_SLOT=1 ;;
            r|R)
                name="${NAMES[CURRENT_IDX]}"
                if [[ $CUR_SLOT -eq 1 ]]; then
                    def=$(default_param_for "$name")
                else
                    def=0
                fi
                set_param "$CURRENT_IDX" "$def" "$CUR_SLOT"
                ;;
            x|X)
                ipc "filter remove $CURRENT_IDX" >/dev/null
                read_filters
                NUM_FILTERS=${#NAMES[@]}
                CUR_SLOT=1
                if [[ $NUM_FILTERS -eq 0 ]]; then
                    echo ""
                    echo "All filters removed. Press 'a' to add one, or 'q' to quit."
                    NUM_FILTERS=0
                    CURRENT_IDX=0
                else
                    if [[ $CURRENT_IDX -ge $NUM_FILTERS ]]; then
                        CURRENT_IDX=$((NUM_FILTERS - 1))
                    fi
                fi
                ;;
            a|A)
                # Restore cooked TTY so the picker can read normally
                stty "$stty_orig"
                echo ""
                SEL=$(pick_filter) || SEL=""
                if [[ -n "$SEL" ]]; then
                    DEF=$(default_param_for "$SEL")
                    ipc "filter add $SEL $DEF" >/dev/null
                    read_filters
                    NUM_FILTERS=${#NAMES[@]}
                    CURRENT_IDX=$((NUM_FILTERS - 1))   # focus the new one
                    CUR_SLOT=1
                fi
                # Back to raw mode for the walk
                stty -echo -icanon time 0 min 1
                echo ""
                ;;
        esac
    fi
    draw
done

stty "$stty_orig"
echo ""
echo "Done. Final filter chain:"
ipc_lines "filter list" | grep "^OK [0-9]" | sed 's/^OK /  /'
